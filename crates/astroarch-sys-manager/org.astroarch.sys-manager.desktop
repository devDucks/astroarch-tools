[Desktop Entry]
Type=Application
Name=Services
Name[it]=Servizi
Name[fr]=Services
Name[de]=Dienste
Name[es]=Servicios
Comment=AstroArch · Bluetooth, file transfer, USB power
Comment[it]=AstroArch · Bluetooth, trasferimento file, alimentazione USB
Comment[fr]=AstroArch · Bluetooth, transfert de fichiers, alimentation USB
Comment[de]=AstroArch · Bluetooth, Dateiübertragung, USB-Strom
Comment[es]=AstroArch · Bluetooth, transferencia de archivos, alimentación USB
Exec=astroarch-control-center --page services --single
Icon=org.astroarch.sys-manager
Categories=System;Settings;
Terminal=false
StartupNotify=true
StartupWMClass=org.astroarch.sys-manager
# One page of the AstroArch Control Center, in its own small window
