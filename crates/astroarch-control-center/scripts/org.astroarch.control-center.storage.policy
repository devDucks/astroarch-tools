<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!-- Image storage page of the Control Center: moving /srv/astro-data to a drive and back
     (astroarch-storage-helper). Installed in /usr/share/polkit-1/actions -->
<policyconfig>
  <vendor>AstroArch</vendor>
  <action id="org.astroarch.control-center.storage">
    <description>Move the AstroArch image folder</description>
    <message>Authentication is required to move the AstroArch image folder</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/astroarch-control-center/astroarch-storage-helper</annotate>
    <annotate key="org.freedesktop.policykit.exec.allow_gui">true</annotate>
  </action>
</policyconfig>
