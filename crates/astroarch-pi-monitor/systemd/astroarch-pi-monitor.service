[Unit]
Description=AstroArch Raspberry Pi monitor (temperature, voltage, alerts)

[Service]
# Type=dbus: ready once org.astroarch.PiMonitor is on the session bus
Type=dbus
BusName=org.astroarch.PiMonitor
ExecStart=@BIN@ daemon
Restart=on-failure
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
