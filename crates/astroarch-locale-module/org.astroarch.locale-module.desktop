[Desktop Entry]
Type=Application
Name=Language and time zone
Name[it]=Lingua e fuso orario
Name[fr]=Langue et fuseau horaire
Name[de]=Sprache und Zeitzone
Name[es]=Idioma y zona horaria
Comment=AstroArch · language, keyboard and time zone
Comment[it]=AstroArch · lingua, tastiera e fuso orario
Comment[fr]=AstroArch · langue, clavier et fuseau horaire
Comment[de]=AstroArch · Sprache, Tastatur und Zeitzone
Comment[es]=AstroArch · idioma, teclado y zona horaria
Exec=astroarch-control-center --page language --single
Icon=org.astroarch.locale-module
Categories=System;Settings;
Terminal=false
StartupNotify=true
StartupWMClass=org.astroarch.locale-module
# One page of the AstroArch Control Center, in its own small window
