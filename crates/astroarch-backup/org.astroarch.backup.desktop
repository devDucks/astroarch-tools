[Desktop Entry]
Type=Application
Name=Data backup
Name[it]=Backup dei dati
Name[fr]=Sauvegarde des données
Name[de]=Datensicherung
Name[es]=Copia de seguridad de datos
Comment=AstroArch · back up settings, images and the system
Comment[it]=AstroArch · backup di impostazioni, immagini e sistema
Comment[fr]=AstroArch · sauvegarder réglages, images et système
Comment[de]=AstroArch · Einstellungen, Bilder und System sichern
Comment[es]=AstroArch · copia de ajustes, imágenes y sistema
Exec=astroarch-control-center --page backup --single
Icon=org.astroarch.backup
Categories=System;Utility;
Terminal=false
StartupNotify=true
StartupWMClass=org.astroarch.backup
# One page of the AstroArch Control Center, in its own small window
